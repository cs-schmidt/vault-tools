{
  "private": true,
  "type": "module",
  "scripts": {
    "build:dev": "webpack --mode development --watch",
    "build:prod": "webpack --mode production",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint --fix .",
    "lint:css": "stylelint \"**/*.css\" --ignore-path .toolignore --fix",
    "format": "prettier --ignore-unknown --ignore-path .toolignore --write .",
    "clean-code": "npm run lint && npm run format"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.0",
    "@eslint/js": "^9.12.0",
    "@types/lodash-es": "^4.17.12",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "dotenv": "^16.4.5",
    "eslint": "^9.12.0",
    "globals": "^15.10.0",
    "mini-css-extract-plugin": "^2.9.1",
    "obsidian": "^1.10.0",
    "prettier": "^3.3.3",
    "style-loader": "^4.0.0",
    "stylelint": "^16.10.0",
    "stylelint-config-clean-order": "^6.1.0",
    "stylelint-config-standard": "^36.0.1",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "lodash-es": "^4.17.21",
    "path-browserify": "^1.0.1",
    "type-detect": "^4.1.0"
  }
}
